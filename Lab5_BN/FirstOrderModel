import random

START, END = "<START>", "<END>"


class FirstOrderLM:
    def __init__(self, sentences):
        """sentences: list of token lists, e.g. [["the", "cat", "sat"], ...]"""
        # 1 + 2. Take tokenised sentences and count transitions between consecutive tokens
        self.counts = {}  # counts[prev][next] = number of times next follows prev
        for sentence in sentences:
            tokens = [START] + sentence + [END]
            for prev, nxt in zip(tokens, tokens[1:]):
                self.counts.setdefault(prev, {})
                self.counts[prev][nxt] = self.counts[prev].get(nxt, 0) + 1

        # 3. Construct P(X_t | X_{t-1}) by normalising each row of counts
        self.probs = {}
        for prev, row in self.counts.items():
            total = sum(row.values())
            self.probs[prev] = {w: c / total for w, c in row.items()}

    # 4. Display the probabilities for a specified previous token
    def show(self, prev):
        if prev not in self.probs:
            print(f"No observed transitions after '{prev}'")
            return
        for word, p in sorted(self.probs[prev].items(), key=lambda x: -x[1]):
            print(f"P({word} | {prev}) = {p:.4f}")

    # 5. Predict the most probable next token
    def predict(self, prev):
        if prev not in self.probs:
            return None
        return max(self.probs[prev], key=self.probs[prev].get)

    # 6 + 7. Generate a sentence by repeatedly sampling; stop at <END>
    def generate(self, max_len=30):
        sentence = []
        prev = START
        while len(sentence) < max_len:
            if prev not in self.probs:      # unseen context: stop safely
                break
            words = list(self.probs[prev].keys())
            weights = list(self.probs[prev].values())
            nxt = random.choices(words, weights=weights, k=1)[0]
            if nxt == END:
                break
            sentence.append(nxt)
            prev = nxt
        return " ".join(sentence)


# ---- Example use ----
text = """the cat sat on the mat
the cat sat on the rug
the dog sat on the mat
the dog ran to the park
the cat ran to the park
the dog sat on the rug"""

training_data = [line.lower().split() for line in text.splitlines()]

lm = FirstOrderLM(training_data)

lm.show("the")                        # probabilities after "the"
print("Most probable after 'the':", lm.predict("the"))

for _ in range(5):
    print(lm.generate())
    

