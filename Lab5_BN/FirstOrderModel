def next_word_report(lm, context):
    """Display P(X_{t+1} | X_t = context) and its arg max."""
    dist = lm.probs.get(context)
    if dist is None:
        print(f"P(X_t+1 | X_t = {context}): no observed transitions\n")
        return

    print(f"P(X_t+1 | X_t = {context})")
    for word, p in sorted(dist.items(), key=lambda x: -x[1]):
        print(f"  P({word:<5} | {context}) = {p:.4f}   {'#' * round(p * 20)}")

    best_p = max(dist.values())
    best = sorted(w for w, p in dist.items() if p == best_p)   # all words tied for the max
    label = best[0] if len(best) == 1 else " / ".join(best) + "  (tie)"
    print(f"  argmax_w P(w | {context}) = {label}\n")


lm = FirstOrderLM(training_data)

for word in ["the", "cat", "dog", "sat", "ran", "on", "to"]:
    next_word_report(lm, word)
    
