import math

def check_normalisation(probabilities, tol=1e-9):
    """Check that for every current word w, sum_v P(v | w) = 1."""
    all_ok = True
    for word in sorted(probabilities):
        total = sum(probabilities[word].values())
        ok = math.isclose(total, 1.0, abs_tol=tol)
        print(f"{word:<8} total = {total:.6f}  {'OK' if ok else 'FAIL'}")
        if not ok:
            all_ok = False
    return all_ok


# ---- Test the real model ----
