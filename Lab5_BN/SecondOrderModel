Second Order Model
This model's implementation was done by modifying the entire code of First order model all together

import random
import math

START, END = "<START>", "<END>"


class SecondOrderLM:
    def __init__(self, sentences):
        # CHANGE 1: counts are of triples, keyed by the two-word context (a, b)
        #           counts[(a, b)][c] = number of times c followed the pair (a, b)
        self.counts = {}
        for sentence in sentences:
            # CHANGE 2: two <START> tokens, so the first word also has a two-word context
            tokens = [START, START] + sentence + [END]
            # CHANGE 3: read consecutive triples instead of consecutive pairs
            for a, b, c in zip(tokens, tokens[1:], tokens[2:]):
                self.counts.setdefault((a, b), {})
                self.counts[(a, b)][c] = self.counts[(a, b)].get(c, 0) + 1

        # Conditional distributions: P(c | a, b) = C(a, b, c) / sum_k C(a, b, k)
        self.probs = {}
        for ctx, row in self.counts.items():
            total = sum(row.values())
            self.probs[ctx] = {w: n / total for w, n in row.items()}

    def show_counts(self, a, b):
        if (a, b) not in self.counts:
            print(f"No observed triples starting with ({a}, {b})")
            return
        for word, n in sorted(self.counts[(a, b)].items(), key=lambda x: -x[1]):
            print(f"C({a}, {b}, {word}) = {n}")

    def show(self, a, b):
        if (a, b) not in self.probs:
            print(f"No observed transitions after ({a}, {b})")
            return
        for word, p in sorted(self.probs[(a, b)].items(), key=lambda x: -x[1]):
            print(f"P({word} | {a}, {b}) = {p:.4f}")

    def predict(self, a, b):
        if (a, b) not in self.probs:
            return None
        dist = self.probs[(a, b)]
        return max(sorted(dist), key=dist.get)

    def next_token(self, a, b, mode="sample"):
        dist = self.probs[(a, b)]
        if mode == "greedy":
            return max(sorted(dist), key=dist.get)
        words = list(dist.keys())
        weights = list(dist.values())
        return random.choices(words, weights=weights, k=1)[0]

    def generate(self, mode="sample", max_len=30):
        if mode not in ("greedy", "sample"):
            raise ValueError("mode must be 'greedy' or 'sample'")
        a, b, sentence = START, START, []
        while len(sentence) < max_len:
            if (a, b) not in self.probs:     # unseen two-word context: stop safely
                break
            nxt = self.next_token(a, b, mode)
            if nxt == END:
                break
            sentence.append(nxt)
            a, b = b, nxt                    # CHANGE 4: slide the two-word window
        return " ".join(sentence)


