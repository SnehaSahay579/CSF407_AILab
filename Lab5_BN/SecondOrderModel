def check_normalisation(probabilities, tol=1e-9):
    """Check that for every context, sum_v P(v | context) = 1."""
    all_ok = True
    for ctx in sorted(probabilities):
        label = " ".join(ctx) if isinstance(ctx, tuple) else ctx   # (a, b) -> "a b"
        total = sum(probabilities[ctx].values())
        ok = math.isclose(total, 1.0, abs_tol=tol)
        print(f"{label:<18} total = {total:.6f}  {'OK' if ok else 'FAIL'}")
        if not ok:
            all_ok = False
    return all_ok


