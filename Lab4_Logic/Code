# BFS planning algorithm
def bfs(initial_state, goal, actions):
    initial_state = frozenset(initial_state)
    goal = set(goal)

    queue = deque([(initial_state, [])])
    visited = {initial_state}

    while queue:
        state, plan = queue.popleft()

        if goal.issubset(state):
            return plan

        for action in actions:
            if action.is_applicable(state):
                next_state = action.apply(state)

                if next_state not in visited:
                    visited.add(next_state)
                    new_plan = plan + [
                        (action.name, next_state)
                    ]
                    queue.append((next_state, new_plan))

    return None


# Find a shortest path through the grid to choose B
def shortest_grid_path(start, goal):
    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        pos, path = queue.popleft()

        if pos == goal:
            return path

        r, c = pos

        for dr, dc, _ in directions:
            nxt = (r + dr, c + dc)

            if walkable(*nxt) and nxt not in visited:
                visited.add(nxt)
                queue.append((nxt, path + [nxt]))

    return None


